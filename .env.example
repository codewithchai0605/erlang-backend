# Copy to .env and edit. NEVER commit .env (it is git-ignored AND docker-ignored). The names here are the
# single source of truth for backend/src/chat_config.erl.
#
# Which file do I need?
#   * `docker compose up --build`        -> NO .env needed at all (sensible defaults). Optional overrides below.
#   * running the backend natively       -> export these variables first (`set -a; . ./.env; set +a`), see docs/operations.md
#   * Render                             -> set them in the dashboard / render.yaml instead (see docs/operations.md)

# --- HTTP / WebSocket listener (TLS is terminated by a reverse proxy / Render; see docs/security.md) ---
# Loopback by default. The Docker image sets 0.0.0.0 itself.
CHAT_HTTP_BIND=127.0.0.1
# PORT (set automatically by Render) is used when CHAT_HTTP_PORT is not set. Default 8080.
CHAT_HTTP_PORT=8080
# Comma-separated browser origins allowed for CORS/WebSocket. Native apps send no Origin header.
CHAT_ALLOWED_ORIGINS=

# --- PostgreSQL: EITHER one connection URL ... ---
# Accepted by CHAT_DATABASE_URL or DATABASE_URL (Render/Heroku style). Query ?sslmode= is understood:
#   disable|allow -> no TLS   prefer|require -> TLS, certificate not verified   verify-ca|verify-full -> TLS + verified
# Explicit CHAT_DB_* variables below override whatever the URL says.
# CHAT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- ... OR the individual settings ---
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=5432
CHAT_DB_NAME=chat_dev
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=change-me
# disable (local), require (encrypted, e.g. managed databases such as Neon), verify (encrypted + certificate checked)
CHAT_DB_SSL=disable
CHAT_DB_POOL_SIZE=10
CHAT_RUN_MIGRATIONS=true

# --- Docker Compose PostgreSQL (docker-compose.yml). Compose's backend always uses THIS local database. ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat_dev

# --- Erlang release ---
# Optional in Docker (a random one is generated). Only matters for `bin/chat remote_console`-style access.
CHAT_NODE_COOKIE=change-me-to-a-long-random-value

# --- Auth ---
CHAT_ACCESS_TOKEN_TTL_SECONDS=900
CHAT_REFRESH_TOKEN_TTL_SECONDS=2592000
CHAT_RATE_AUTH_PER_MINUTE=20

# --- Chat limits ---
CHAT_MAX_WS_MESSAGE_BYTES=65536
CHAT_MAX_MESSAGE_TEXT_CHARS=4000
CHAT_MAX_CONNECTIONS=10000
CHAT_RATE_SEND_PER_MINUTE=120
CHAT_WS_HELLO_TIMEOUT_MS=10000
CHAT_WS_IDLE_TIMEOUT_MS=60000
CHAT_WS_MAX_QUEUE=1000

# --- Groups, typing, presence (Milestone 5) ---
CHAT_MAX_GROUP_MEMBERS=100
CHAT_RATE_GROUP_PER_MINUTE=30
CHAT_RATE_TYPING_PER_MINUTE=120
# A user is announced offline only after their LAST connection has been gone this long (hides reconnect flicker).
CHAT_PRESENCE_GRACE_MS=5000

# --- Tests only (backend/test/chat_e2e_SUITE.erl); use a DISPOSABLE database ---
# CHAT_TEST_DB_NAME=chat_test
# CHAT_TEST_DB_USER=chat
# CHAT_TEST_DB_PASSWORD=change-me
# CHAT_TEST_DB_HOST=127.0.0.1
# CHAT_TEST_DB_SSL=disable
