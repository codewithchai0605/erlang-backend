# Copy to .env and edit. NEVER commit .env. Names here are the single source of truth for
# backend/src/chat_config.erl. Export them (e.g. `set -a; . ./.env; set +a`) before starting the backend.

# --- HTTP / WebSocket listener (TLS is terminated by a reverse proxy; see docs/security.md) ---
CHAT_HTTP_BIND=127.0.0.1
CHAT_HTTP_PORT=8080
# Comma-separated browser origins allowed for CORS/WebSocket. Native apps send no Origin header.
CHAT_ALLOWED_ORIGINS=

# --- PostgreSQL ---
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=5432
CHAT_DB_NAME=chat_dev
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=change-me
CHAT_DB_POOL_SIZE=10
CHAT_RUN_MIGRATIONS=true

# --- Docker Compose PostgreSQL (docker-compose.yml) - keep in sync with the CHAT_DB_* values above ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat_dev

# --- Erlang release ---
CHAT_NODE_COOKIE=change-me-to-a-long-random-value

# --- Auth ---
CHAT_ACCESS_TOKEN_TTL_SECONDS=900
CHAT_REFRESH_TOKEN_TTL_SECONDS=2592000
CHAT_RATE_AUTH_PER_MINUTE=20

# --- Chat limits ---
CHAT_MAX_WS_MESSAGE_BYTES=65536
CHAT_MAX_MESSAGE_TEXT_CHARS=4000
CHAT_MAX_CONNECTIONS=10000
CHAT_RATE_SEND_PER_MINUTE=120
CHAT_WS_HELLO_TIMEOUT_MS=10000
CHAT_WS_IDLE_TIMEOUT_MS=60000
CHAT_WS_MAX_QUEUE=1000

# --- Tests only (backend/test/chat_e2e_SUITE.erl); use a DISPOSABLE database ---
# CHAT_TEST_DB_NAME=chat_test
# CHAT_TEST_DB_USER=chat
# CHAT_TEST_DB_PASSWORD=change-me
