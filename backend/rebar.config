%% Dependency ranges are loose ("~>"); rebar.lock pins the exact versions that were tested. Commit the lock
%% and update dependencies deliberately (ADR 0002).
{minimum_otp_vsn, "27"}.   %% uses the built-in `json` module (OTP 27+), see ADR 0003

{erl_opts, [debug_info, {i, "include"}]}.
%% rebar3 compiles src/ recursively, which includes the generated src/gen/chat_pb.erl.
%% Once the code compiles cleanly on your machine, add: warnings_as_errors

{deps, [
  {cowboy, "~> 2.20"},
  {epgsql, "~> 4.8"},
  {poolboy, "~> 1.5"},
  {bcrypt, "~> 2.0"}
]}.

{plugins, [rebar3_gpb_plugin]}.
{gpb_opts, [
  {i, "../proto"},
  {recursive, true},
  {o_erl, "src/gen"},
  {o_hrl, "include"},
  {module_name_suffix, "_pb"},
  maps,
  strings_as_binaries,
  type_specs
]}.
{provider_hooks, [{pre, [{compile, {protobuf, compile}}]}]}.

{relx, [
  {release, {chat, "0.1.0"}, [chat, sasl]},
  {sys_config, "config/sys.config"},
  {vm_args_src, "config/vm.args.src"},
  {mode, dev},
  {extended_start_script, true}
]}.

{profiles, [
  %% `rebar3 as prod release`: self-contained (ERTS included), no source, used by the Dockerfile.
  {prod, [{relx, [{mode, prod}, {include_erts, true}, {include_src, false}, {debug_info, strip}]}]},
  {test, [{deps, [{gun, "~> 2.1"}]}, {erl_opts, [nowarn_export_all]}]}
]}.

{eunit_opts, [verbose]}.
{dialyzer, [{warnings, [unknown]}]}.
